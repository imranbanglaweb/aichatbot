# Frontend Environment Variables
# Copy this file to .env and update the values

# API Configuration
# For development, use localhost
# For production, use your server URL
REACT_APP_API_URL=http://localhost:8000/api

# Optional: Enable production mode
# NODE_ENV=production

# Pusher Configuration (for WebRTC voice calls)
# These will be fetched from the backend API, but can be set manually
# REACT_APP_PUSHER_KEY=your_pusher_key
# REACT_APP_PUSHER_CLUSTER=your_pusher_cluster
